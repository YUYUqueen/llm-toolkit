{
  "name": "@yuyuqueen/prompt-assembler",
  "version": "0.1.0",
  "description": "Modular system prompt assembly for LLM applications. Section-based builder with conditional rendering, tool formatting, and context file injection.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "llm",
    "prompt",
    "system-prompt",
    "template",
    "assembler",
    "anthropic",
    "openai",
    "ai"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
