{
  "name": "@yuyuqueen/resilient-llm",
  "version": "0.1.0",
  "description": "Production-grade fault-tolerant wrapper for LLM API calls. Multi-key rotation, provider fallback, context overflow recovery, thinking level downgrade, accurate token tracking.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "llm",
    "resilient",
    "retry",
    "fallback",
    "rate-limit",
    "anthropic",
    "openai",
    "gemini",
    "ai"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
